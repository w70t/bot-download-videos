# ═══════════════════════════════════════════════════════════
# Telegram Bot Configuration - إعداد البوت
# ═══════════════════════════════════════════════════════════
# احصل على هذه القيم من: https://my.telegram.org/apps
PYROGRAM_API_ID=12345678
PYROGRAM_API_HASH=0123456789abcdef0123456789abcdef

# احصل على Token من: @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ═══════════════════════════════════════════════════════════
# Admin Configuration - معلومات المدير
# ═══════════════════════════════════════════════════════════
# ضع Telegram ID الخاص بك (رقمك التعريفي)
ADMIN_ID=123456789

# معرّف Binance Pay لاستقبال المدفوعات (اختياري)
BINANCE_PAY_ID=

# معرّف حساب الدعم على تيليجرام بدون @ (اختياري)
SUPPORT_USERNAME=

# ═══════════════════════════════════════════════════════════
# PostgreSQL Database - قاعدة البيانات
# ═══════════════════════════════════════════════════════════
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telegram_bot
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=your_secure_password_here

# حجم مجمّع اتصالات قاعدة البيانات (اختياري)
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# ⚡ ذاكرة الإعدادات واللغات (بالثواني). psycopg2 متزامن، فكل استعلام من معالج
# async يُجمّد البوت لكل الأعضاء طوال رحلته — والإعدادات ولغة العضو شبه ثابتة.
# الصحّة مضمونة بالإبطال لا بالمهلة: كل ضغطة زر من الأدمن تمسح مفتاحها فوراً،
# فلا تظهر قيمة قديمة أبداً. المهلة شبكة أمان للتعديل اليدوي في قاعدة البيانات.
# SETTINGS_CACHE_TTL=60
# LANG_CACHE_TTL=300
# LANG_CACHE_MAX=2000

# ⚡ ذاكرة فحص المضيف (حماية SSRF). socket.getaddrinfo حاجب وقياسه ٢٠–٢١٥ م.ث
# للطلب الواحد بلا أي تخزين في النظام، ويُستدعى داخل حلقة الأحداث لكل رسالة.
# أبقِ المهلة قصيرة: الحكم المخزَّن «آمن» يوسّع نافذة إعادة ربط DNS نظرياً.
# URL_HOST_CACHE_TTL=300
# URL_HOST_CACHE_MAX=512

# ═══════════════════════════════════════════════════════════
# تحسين سرعة التحميل - Download speed (اختياري)
# ═══════════════════════════════════════════════════════════
# عدد أجزاء التحميل المتوازية (أسرع ليوتيوب). تجنّب القيم العالية جداً (>16)
YTDLP_CONCURRENT_FRAGMENTS=4

# عملاء يوتيوب مفصولين بفاصلة (أقل = أسرع استخراج). اتركه فارغاً للافتراضي
# YT_PLAYER_CLIENTS=default,web_safari,mweb

# مرايا إنستغرام البديلة (InstaFix) لتحميل الريلز بلا كوكيز حين يفشل yt-dlp
# (إنستغرام يحجب الوصول المجهول). مفصولة بفاصلة، تُجرَّب بالترتيب. غيّرها إن
# تعطّلت المرآة الافتراضية.
# تدعم أيضاً ستوري الحسابات العامة بلا كوكيز: مستخرِج yt-dlp للستوري يردّ
# «You need to log in» والمرآة ترفض مسار /stories/، لكن معرّف عنصر الستوري في
# نفس فضاء معرّفات المنشورات — فيُرمَّز لرمزه القصير ويُطلب على مسار /p/.
# (شرطان طبيعيان: الحساب عام، والستوري لم تمرّ عليه ٢٤ ساعة)
# INSTAGRAM_PROXY_HOSTS=kkinstagram.com

# 📚 «الأبرز» (Highlights) كاملاً بلا كوكيز: نقطة إنستغرام الداخلية reels_media
# تسلّم أي مجموعة «أبرز» عامة كاملة لأي زائر بترويسة X-IG-App-ID وحدها — لكل
# عنصر رابط mp4 مباشر ومصغّرة ومدّة وأبعاد. فيسأل البوت العضو: هذا المقطع فقط
# أم المجموعة كاملة؟ (ملاحظة: نفس النقطة بمعرّف حساب تردّ فارغة دائماً، فتعداد
# ستوري الـ٢٤ ساعة مقفل للزوّار — المتاح عنصرٌ تعرف رقمه أو «أبرز» تعرف رقمه.)
# غيّر هذين إن غيّر إنستغرام معرّف التطبيق أو مسار النقطة.
# INSTAGRAM_APP_ID=936619743392459
# INSTAGRAM_REELS_MEDIA_API=https://i.instagram.com/api/v1/feed/reels_media/

# سقف عناصر «الأبرز» الواحد (مجموعة قد تبلغ ١٠٠ عنصر ≈ ساعة رفعاً من الجهاز).
# هذه القيمة الأولية فقط — بعد أول تشغيل تُدار من لوحة الأدمن:
# 💎 إعدادات الاشتراك ← 📚 حد عناصر «الأبرز»
# INSTAGRAM_HIGHLIGHT_MAX_ITEMS=25

# مرايا ثريدز: yt-dlp لا يملك مستخرِجاً لثريدز إطلاقاً، وصفحة المنشور لا تعطي
# الزوّار أي وسائط، فالمرآة هي الطريق الوحيد. مفصولة بفاصلة، تُجرَّب بالترتيب.
# مهم: هذه المرايا تتعطّل فعلاً — عند الكتابة كانت vxthreads.net وfixthreads.net
# تردّان 503 وvxthreads.com وحدها تعمل. غيّر القائمة إن توقّف التحميل.
# THREADS_PROXY_HOSTS=vxthreads.com,vxthreads.net,fixthreads.net

# مرايا تيك توك البديلة لتحميل الفيديو بلا كوكيز حين يحجب تيك توك عنوان IP
# الخادم ("Your IP address is blocked") فيفشل yt-dlp حتى مع كوكيز صالحة.
# مفصولة بفاصلة، تُجرَّب بالترتيب. غيّرها إن تعطّلت المرآة الافتراضية.
# TIKTOK_PROXY_HOSTS=tikwm.com

# 🔎 تحليل مصدر مقاطع تيك توك: يعرض مع الفيديو بلد نشر المقطع وتاريخ إنشاء
# حساب الناشر — كلاهما بيانات عامة يراها أي زائر. اضبط 0 لتعطيله
# (يوفّر طلبين شبكيين لكل مقطع تيك توك).
# TIKTOK_SOURCE_ANALYSIS=1

# مهلتا التحليل: لكل طلب، وسقف كلّي للمراحل الأربع مجتمعةً. السقف الكلّي يحمي
# إعادة الإرسال من الكاش (المفترَض أن تكون فورية) من تباطؤ تيك توك — عند
# تجاوزه تُرسَل الوسائط بلا سطري المصدر بدل أن ينتظر العضو.
# TIKTOK_ANALYSIS_REQUEST_TIMEOUT=8
# TIKTOK_ANALYSIS_TOTAL_TIMEOUT=12

# مرايا تويتر/X البديلة لتحميل الفيديو بلا كوكيز حين يفشل yt-dlp (حجب/تقييد).
# مفصولة بفاصلة، تُجرَّب بالترتيب. غيّرها إن تعطّلت المرآة الافتراضية.
# TWITTER_PROXY_HOSTS=api.vxtwitter.com,api.fxtwitter.com

# مضيفات واجهة بينتريست العامة (فيديو + صور الكاروسيل بلا كوكيز) حين يفشل
# yt-dlp/gallery-dl. مفصولة بفاصلة، تُجرَّب بالترتيب. غيّرها إن تعطّل مضيف.
# PINTEREST_PROXY_HOSTS=www.pinterest.com,api.pinterest.com

# سناب شات: خدمة الوسائط الداخلية تعطي الفيديو الخام بلا اللوقو المطبوع في
# نسخة الويب (بلا كوكيز). اضبط 0 للعودة لسلوك نسخة الويب السابق، أو غيّر
# العنوان إن غيّره سناب.
# SNAPCHAT_CLEAN_MEDIA=1
# SNAPCHAT_MEDIA_SERVICE=https://ms.sc-jpl.com/web/getStoryElements

# رقم رندر سناب شات النظيف (بلا لوقو) — خطّ الدفاع الأخير حين تفشل الخدمة
# أعلاه. وسائط سناب كائنات ثابتة اسمها «<معرّف>.<رقم الرندر>.<رمز السياق>»؛
# الرندر 27 (وهو ما تعطيه الصفحة في mediaUrl وcontentUrl معاً) يحرق اللوقو
# واسم الحساب داخل الصورة، والرندر 1034 نفس المقطع بلا لوقو إطلاقاً.
#
# لا حاجة لضبطه هنا عادةً: أدِره من البوت عبر
#   💎 إعدادات الاشتراك ← 👻 سناب بلا لوقو ← 🔍 فحص برابط
# فيمسح الأرقام على مقطع حقيقي ويعطيك زرّاً للرقم الصحيح، ويُحفظ في قاعدة
# البيانات ويسري فوراً. القيمة هنا هي الافتراضي وزرّ «إعادة للافتراضي».
# SNAPCHAT_CLEAN_RENDITION=1034

# مسارات احتياطية للنسخة النظيفة: نسخ المقطع الواحد ليست دائماً تحت مضيف/مسار
# نسخة المشاركة، فإن لم تُوجد على مساره جُرّبت هذه بالترتيب (بها صارت التغطية
# 59/59 بدل 24/26). مفصولة بفاصلة، بلا شرطة في النهاية.
# SNAPCHAT_FALLBACK_BASES=https://cf-st.sc-cdn.net/d,https://bolt-gcdn.sc-cdn.net/3

# ═══════════════════════════════════════════════════════════
# Channels Configuration - قنوات التسجيل (اختياري)
# ═══════════════════════════════════════════════════════════
# قناة سجلات تحميل الفيديوهات (اختياري - اتركها فارغة إذا لم تحتاجها)
LOG_CHANNEL_ID=-1001234567890

# قناة سجلات الأخطاء (اختياري - اتركها فارغة إذا لم تحتاجها)
ERROR_LOG_CHANNEL_ID=-1001234567890

# قناة إشعارات الأعضاء الجدد (اختياري - اتركها فارغة إذا لم تحتاجها)
NEW_MEMBERS_CHANNEL_ID=-1001234567890

# ملاحظة: الكاش يعيد استخدام نسخة قناة السجلات (LOG_CHANNEL_ID) كمرجع دائم،
# فلا حاجة لقناة أرشيف منفصلة.

# قناة إجابات الاستبيان: تصل فيها إجابات الأعضاء (الجنس + سؤالك) مع زر رد
# مباشر للعضو (اختياري - أضف البوت كمشرف فيها)
SURVEY_CHANNEL_ID=-1001234567890

# قناة النسخ الاحتياطي: تُرفع فيها نسخة كاملة من بيانات الأعضاء (JSON) تلقائياً
# ويدوياً، وتُسترجَع منها عند تعطّل الجهاز (اختياري - أضف البوت كمشرف)
BACKUP_CHANNEL_ID=-1001234567890

# مدة النسخ التلقائي بالساعات (0 لتعطيله، الافتراضي 12)
AUTO_BACKUP_HOURS=12

# 🌐 مراقبة المرايا: البوت يقف على مرايا طرف ثالث وهي تموت بلا إنذار (عند
# الكتابة كانت vxthreads.net وfixthreads.net ساقطتين فعلاً). المراقبة تفحصها
# دورياً وتراسل الأدمن **عند تغيّر الحالة فقط** — سقوط أو تعافٍ — فلا تصل
# رسائل مكرّرة عن عطل معروف. 0 لتعطيلها.
# لا حاجة لضبطها هنا: أدِرها من البوت عبر
#   💎 إعدادات الاشتراك ← 🌐 مراقبة المرايا
# فتُحفظ في قاعدة البيانات وتسري من الدورة التالية. القيمة هنا هي الافتراضي.
# MIRROR_WATCH_HOURS=1

# كل دعوة ناجحة تزيد الحد اليومي للداعي بهذا المقدار (دائماً، الافتراضي 1)
REFERRAL_BONUS=1

# دقائق مكافأة الدعوة (تُضاف لحدّ مدة الفيديو للداعي مع كل دعوة ناجحة، دائماً).
# هذه القيمة الأولية فقط — بعد أول تشغيل تُدار من لوحة الأدمن:
# ⚙️ إعدادات الاشتراك ← تحديد المدة القصوى ← 🎁 دقائق مكافأة الدعوة
REFERRAL_MINUTES=5

# أقصى عدد صور تُحمَّل من منشور إنستغرام/تيك توك المصوّر (كاروسيل/سلايدشو، الافتراضي 30)
GALLERY_DL_MAX_IMAGES=30

# عدد أيام الخمول لاعتبار العضو غير نشط في زر التذكير (الافتراضي 7)
REMINDER_INACTIVE_DAYS=7
